# Supabase — copy these from your project dashboard (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon public key>

# Server-only. Bypasses Row Level Security — never expose it to the browser and
# never prefix it with NEXT_PUBLIC_. Used for staff/admin tasks such as seeding
# events or issuing certificates.
SUPABASE_SERVICE_ROLE_KEY=<service_role secret key>
