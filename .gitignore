# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (keep the documented template)
.env*
!.env.example

# local sqlite database files
/data/*.db
/data/*.db-*
/data/*.sqlite
/data/*.sqlite-*

# local social media uploads
/public/uploads/

# local instagram sync data
/data/instagram-posts.json

# vercel
.vercel

# typescript
next-env.d.ts
*.tsbuildinfo

#context
context.txt